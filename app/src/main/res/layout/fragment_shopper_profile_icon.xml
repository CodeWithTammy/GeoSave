<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ShopperScreen.ShopperProfileIcon"
    android:background="@color/white">

 <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent" >
        <RelativeLayout
            android:id="@+id/layout1"
            android:layout_width="match_parent"
            android:layout_height="740dp">

            <TextView
                android:id="@+id/profiletxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/inter_bold"
                android:text="Profile"
                android:textColor="#000000"
                android:textSize="15sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="700dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="40dp"
                android:background="@drawable/cornerprofile">

            </RelativeLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profilepictureholder"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="90dp"
                android:src="@drawable/defaultpfp"
                app:shapeAppearanceOverlay="@style/circular" />


            <TextView
                android:id="@+id/shoppername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/profilepictureholder"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/inter_bold"
                android:text="TextView"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/shopperemail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/shoppername"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:text="TextView"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/edtprofilebtn"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:layout_below="@+id/shopperemail"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_bold"
                android:text="Edit Profile"
                android:textColor="#FFFFFF"
                android:background="@drawable/buttoneditprofile"/>

            <TextView
                android:id="@+id/settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:layout_marginTop="40dp"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:layout_marginStart="30dp"
                android:fontFamily="@font/inter"
                android:layout_below="@+id/edtprofilebtn"/>
            <View
                android:id="@+id/settingline"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/settings"
                android:background="#42FFFFFF"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="20dp"/>
            <ImageButton
                android:id="@+id/setingbtn"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_below="@id/edtprofilebtn"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="300dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/imagebuttonbackground"
                android:src="@drawable/outline_arrow_forward_ios_24" />


            <TextView
                android:id="@+id/personaldetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal details"
                android:layout_marginTop="40dp"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:layout_marginStart="30dp"
                android:fontFamily="@font/inter"
                android:layout_below="@+id/settings"/>
            <View
                android:id="@+id/personalline"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/personaldetails"
                android:background="#42FFFFFF"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="20dp"/>
            <ImageButton
                android:id="@+id/personalbtn"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_below="@id/settingline"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="300dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/imagebuttonbackground"
                android:src="@drawable/outline_arrow_forward_ios_24" />


            <TextView
                android:id="@+id/about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About account"
                android:textColor="#FFFFFF"
                android:layout_marginStart="30dp"
                android:textSize="17sp"
                android:fontFamily="@font/inter"
                android:layout_marginTop="40dp"
                android:layout_below="@+id/personaldetails"/>
            <ImageButton
                android:id="@+id/aboutbtn"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_below="@id/personalline"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="300dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/imagebuttonbackground"
                android:src="@drawable/outline_arrow_forward_ios_24" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/logoutbtn"
                android:layout_width="200dp"
                android:layout_height="59dp"
                android:layout_below="@+id/about"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="40dp"
                android:background="@drawable/logoutbtn"
                android:fontFamily="@font/inter_bold"
                android:text="Logout"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/deletetxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/logoutbtn"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="90dp"
                android:fontFamily="@font/inter"
                android:text="Delete account"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </RelativeLayout>
    </ScrollView>


</RelativeLayout>