<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Components.NewDealCard"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/addtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/inter_bold"
                android:text="Add Deal"
                android:textColor="#000000"
                android:textSize="15sp" />

            <TextView
        android:id="@+id/nameofstoretxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="30dp"
        android:layout_marginTop="100dp"
        android:fontFamily="@font/inter"
        android:text="Name of Store"
        android:textColor="#000000"
        android:textSize="15sp"
        tools:layout_editor_absoluteX="94dp"
        tools:layout_editor_absoluteY="42dp" />

    <EditText
        android:id="@+id/nameofstoreedttxt"
        android:layout_width="350dp"
        android:layout_height="50dp"
        android:layout_below="@+id/nameofstoretxt"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="350dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="350dp"
        android:background="@drawable/textboxinput"
        android:ems="10"
        android:fontFamily="@font/inter"
        android:hint="Enter name...."
        android:inputType="text"
        android:paddingLeft="15dp"
        android:textColor="#000000"
        android:textSize="15sp"
        tools:layout_editor_absoluteX="100dp"
        tools:layout_editor_absoluteY="75dp" />

    <TextView
        android:id="@+id/descriptiontxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="15sp"
        android:text="Description of Sale"
        android:layout_marginStart="30dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/inter"
        android:layout_below="@+id/nameofstoreedttxt"
        tools:layout_editor_absoluteX="73dp"
        tools:layout_editor_absoluteY="181dp" />

    <EditText
        android:id="@+id/descriptionedttxt"
        android:layout_width="350dp"
        android:layout_height="150dp"
        android:layout_below="@+id/descriptiontxt"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="350dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="350dp"
        android:background="@drawable/textboxinput"
        android:ems="10"
        android:gravity="start|top"
        android:fontFamily="@font/inter"
        android:hint="Enter description of sale...."
        android:inputType="textMultiLine|textCapSentences"
        android:lines="3"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="12dp"
        android:textColor="#000000"
        android:textSize="15sp"
        tools:layout_editor_absoluteX="82dp"
        tools:layout_editor_absoluteY="224dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/submitbtn"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/descriptionedttxt"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:background="@drawable/corner"
        android:fontFamily="@font/inter"
        android:text="Submit"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/canceltxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/submitbtn"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="25dp"
        android:text="Cancel"
        android:textColor="@color/darkblue"
        android:textSize="15sp" />

            <ImageButton
                android:id="@+id/deletebtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentRight="true"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="30dp"
                app:srcCompat="@drawable/round_delete_outline_24" />


        </RelativeLayout>
    </ScrollView>

</RelativeLayout>