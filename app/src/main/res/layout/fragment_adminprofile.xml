<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Admin.Adminprofile"
    android:orientation="vertical"
    android:background="@drawable/gradient">

    <TextView
        android:id="@+id/profiletxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/inter_bold"
        android:text="Profile"
        android:textColor="#FFFFFF"
        android:layout_gravity="center_horizontal"
        android:textSize="15sp" />

    <!-- Profile Picture ImageView -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageViewProfile"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_below="@+id/profiletxt"
        android:layout_marginTop="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_centerHorizontal="true"
        app:shapeAppearanceOverlay="@style/circular"
        android:src="@drawable/adminpfp" />
    <TextView
        android:id="@+id/shoppername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/profilepictureholder"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/inter_bold"
        android:text="Administrator"
        android:layout_gravity="center_horizontal"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

<!--    <TextView-->
<!--        android:id="@+id/shopperemail"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_below="@id/shoppername"-->
<!--        android:layout_gravity="center_horizontal"-->
<!--        android:layout_marginTop="10dp"-->
<!--        android:fontFamily="@font/inter"-->
<!--        android:text="TextView"-->
<!--        android:layout_marginBottom="20dp"-->
<!--        android:textAlignment="center"-->
<!--        android:textColor="#FFFFFF"-->
<!--        android:textSize="14sp" />-->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp">

    <TextView
        android:id="@+id/textViewEmailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Email Address"
        android:textColor="@color/lightblue"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adminemail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/textViewPasswordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Password"
        android:textColor="@color/lightblue"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adminpassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="italic"
        android:inputType="textPassword" />

</LinearLayout>

    <LinearLayout
        android:id="@+id/changepasslayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="100dp">

    <TextView
        android:id="@+id/settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Password"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="30dp"
        android:fontFamily="@font/inter" />
    <ImageButton
        android:id="@+id/passbtn"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_below="@id/edtprofilebtn"
        android:layout_marginEnd="30dp"
        android:layout_marginStart="150dp"
        android:background="@drawable/imagebuttonbackground"
        android:src="@drawable/outline_arrow_forward_ios_24" />
    </LinearLayout>



    <androidx.appcompat.widget.AppCompatButton
    android:id="@+id/logoutbtn"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:text="Logout"
    android:layout_gravity="center_horizontal"
    android:textColor="@color/white"
    android:background="@drawable/logoutbtn"/>

</LinearLayout>