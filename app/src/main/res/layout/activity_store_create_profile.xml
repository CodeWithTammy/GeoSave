<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFFFF"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollviewprofile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:fillViewport="true"
        android:paddingTop="40dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                app:srcCompat="@drawable/baseline_arrow_back_ios_24" />

            <TextView
                android:id="@+id/addtoaccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="105dp"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="-30dp"
                android:text="Add to your account\n\n"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/addtoaccountinfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginBottom="14dp"

                android:text="This additional information will allow the app to have access to your location and personalize your account."
                android:textColor="#6B6B6E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/addresstxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="33dp"
                android:layout_marginBottom="5dp"
                android:text="Address"
                android:textColor="#031832"
                android:textSize="14sp" />

<!--            <LinearLayout-->
<!--                android:id="@+id/addressbox"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginHorizontal="27dp"-->
<!--                android:layout_marginBottom="29dp"-->
<!--                android:background="@drawable/sffe2e1e5sw1cr14bffffffff"-->
<!--                android:orientation="vertical"-->
<!--                android:paddingHorizontal="15dp"-->
<!--                android:paddingTop="19dp"-->
<!--                android:paddingBottom="99dp">-->

<!--                <TextView-->
<!--                    android:id="@+id/addressboxtext"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="Address"-->
<!--                    android:textColor="#D2D2D2"-->
<!--                    android:textSize="14sp" />-->
<!--            </LinearLayout>-->

            <EditText
                android:id="@+id/addressinput"
                android:layout_width="350dp"
                android:layout_height="100dp"
                android:gravity="start|top"
                android:layout_marginLeft="30dp"
                android:paddingLeft="12dp"
                android:background="@drawable/textboxinput"
                android:ems="10"
                android:lines="3"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="12dp"
                android:layout_marginBottom="20dp"
                android:hint="Type Address here...."
                android:inputType="textPostalAddress"
                android:maxLines="4"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/phonetxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="34dp"
                android:layout_marginBottom="4dp"
                android:text="Phone number"
                android:textColor="#031832"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/phonenumber"
                android:layout_width="350dp"
                android:layout_height="55dp"
                android:layout_marginLeft="30dp"
                android:background="@drawable/textboxinput"
                android:ems="10"
                android:layout_marginBottom="20dp"
                android:paddingLeft="12dp"
                android:inputType="phone"
                android:textSize="14sp"
                android:hint="Enter phone number"/>

            <TextView
                android:id="@+id/selectxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="37dp"
                android:layout_marginBottom="29dp"
                android:text="Select your type of store:"
                android:textColor="#000000"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/department"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Department Store"
                android:layout_marginLeft="30dp"/>

            <CheckBox
                android:id="@+id/Supermarket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supermarket"
                android:layout_gravity="end"
                android:layout_marginTop="-50dp"
                android:layout_marginHorizontal="30dp"/>

            <CheckBox
                android:id="@+id/stationery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stationery"
                android:layout_marginLeft="30dp"/>

            <CheckBox
                android:id="@+id/restaurant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restaurant"
                android:layout_gravity="end"
                android:layout_marginTop="-50dp"
                android:layout_marginHorizontal="40dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="250dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginTop="100dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/submitbtn"
                    android:layout_width="250dp"
                    android:layout_height="50dp"
                    android:background="@drawable/corner"
                    android:text="Submit"
                    android:textColor="@color/white"/>
            </androidx.cardview.widget.CardView>


        </LinearLayout>
    </ScrollView>


</LinearLayout>