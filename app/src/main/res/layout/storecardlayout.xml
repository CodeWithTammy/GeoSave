<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="350dp"
        android:layout_height="100dp"
        android:backgroundTint="#F0F0F0"
        android:layout_marginTop="30dp"
        app:cardCornerRadius="20dp"
        android:elevation="20dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="122dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profilepictureholder"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="20dp"
                android:src="@drawable/defaultpfp"
                android:visibility="visible"
                app:shapeAppearanceOverlay="@style/circular" />
<LinearLayout
    android:id="@+id/layout1"
    android:layout_toEndOf="@id/profilepictureholder"
    android:layout_marginLeft="-10dp"
    android:layout_centerVertical="true"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="30dp">


    <TextView
        android:id="@+id/storename"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:text="Store Name"
        android:textColor="@color/darkblue"
        android:textSize="16sp"
        android:fontFamily="@font/dm_serif_display"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/saletxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This store has a sale going on. Click to see more"
        android:textColor="#5B5858"
        android:textSize="14sp" />




</LinearLayout>
            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/layout1"
                android:layout_gravity="center"
                app:srcCompat="@drawable/bigarrow" />


        </RelativeLayout>
    </androidx.cardview.widget.CardView>


</RelativeLayout>


